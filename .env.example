# MongoDB Atlas connection string (must be a replica set for Better Auth transactions)
DATABASE_URI=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible)
# R2_BUCKET is the PUBLIC bucket: admin media, blog images, logos. It has the
# public dev URL / custom domain attached, so everything in it is world
# readable by URL.
R2_BUCKET=
# Separate bucket for candidate resumes, with NO public URL and no custom
# domain. Public access in R2 is per-bucket and all-or-nothing, so resumes
# cannot live in the public bucket. Falls back to R2_BUCKET if unset, which
# is unsafe in production — see src/lib/r2.ts.
R2_PRIVATE_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Account-level S3 endpoint, no bucket suffix: https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL for the PUBLIC bucket only. Either the r2.dev dev URL or a
# dedicated subdomain such as https://cdn.movodream.com — never a hostname the
# website itself serves. Any custom domain must also be added to
# `remotePatterns` in next.config.ts.
R2_PUBLIC_URL=

# GoDaddy/Secureserver SMTP (existing client mailbox — do not create a new provider)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
HR_NOTIFICATION_EMAIL=

# Analytics (carry forward from the live site — do not drop the Meta Pixel)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=2559769347806340

# Seed script — first admin account (change immediately after first login)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
